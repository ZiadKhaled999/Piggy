<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Large Mascot Image: Fills full 2x1 widget area covering width and height -->
    <ImageView
        android:id="@+id/iv_streak_mascot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_piggy_happy"
        android:contentDescription="Piggy Mascot" />

    <!-- Overlay Content Structure -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layoutDirection="locale"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp">

        <!-- Top Header: Streak Status Icon + Bold White Count -->
        <LinearLayout
            android:id="@+id/ll_streak_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/iv_streak_status_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/streak"
                android:scaleType="fitCenter"
                android:contentDescription="Streak Status"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_streak_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="123"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:shadowColor="#CC000000"
                android:shadowDx="1.0"
                android:shadowDy="1.0"
                android:shadowRadius="4.0"
                android:fontFamily="sans-serif-black" />
        </LinearLayout>

        <!-- Sub-header Message: Transparent background, clean white text with drop shadow -->
        <TextView
            android:id="@+id/tv_streak_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAlignment="center"
            android:text="Practice now?"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#CC000000"
            android:shadowDx="1.0"
            android:shadowDy="1.0"
            android:shadowRadius="3.0"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>
</FrameLayout>
