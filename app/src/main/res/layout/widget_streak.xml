<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_streak_widget"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Mascot on the left, fits the height -->
    <ImageView
        android:id="@+id/iv_streak_mascot"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.8"
        android:src="@drawable/img_streak_mascot_new"
        android:scaleType="fitCenter"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:contentDescription="Mascot" />

    <!-- Streak Info in the center -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.8"
        android:orientation="vertical"
        android:gravity="start|center_vertical"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/tv_streak_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active streak"
            android:textColor="#F43F5E"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tv_streak_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 days"
            android:textColor="#374151"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="6dp" />

        <!-- Day Indicators Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_day_sun"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_streak_day_inactive"
                android:text="S"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_day_mon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_streak_day_inactive"
                android:text="M"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_day_tue"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_streak_day_inactive"
                android:text="T"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_day_wed"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_streak_day_inactive"
                android:text="W"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_day_thu"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_streak_day_inactive"
                android:text="T"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_day_fri"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_streak_day_inactive"
                android:text="F"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_day_sat"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_streak_day_inactive"
                android:text="S"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
