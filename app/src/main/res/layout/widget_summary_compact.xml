<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <!-- Column 1: Owed to Me -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/tv_label_owed_to_me"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_owed_to_me"
            android:textColor="@color/widget_text_dark"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:id="@+id/tv_owed_to_me"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/widget_green"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Divider 1 -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="22dp"
        android:background="@color/widget_border_light"
        android:layout_gravity="center_vertical" />

    <!-- Column 2: I Owe -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/tv_label_i_owe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_i_owe"
            android:textColor="@color/widget_text_dark"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:id="@+id/tv_i_owe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/widget_red"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Divider 2 -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="22dp"
        android:background="@color/widget_border_light"
        android:layout_gravity="center_vertical" />

    <!-- Column 3: Net Ledger -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.15"
        android:background="@drawable/bg_widget_pill"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="4dp">

        <TextView
            android:id="@+id/tv_net_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_net_ledger"
            android:textColor="@color/widget_text_dark"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:id="@+id/tv_net_ledger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/widget_text_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

</LinearLayout>
